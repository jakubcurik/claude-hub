# Zkopíruj jako `.env` a doplň hodnoty pro lokální vývoj.
# Docker Compose tento soubor automaticky načte.

# Workspace root (kde leží projekty s .claude/ adresářem). Daemon ji namountuje
# read-only a detekuje project-level skilly, příkazy, hooky a MCP konfigurace.
#
# Pozn.: daemon kromě této cesty AUTOMATICKY čte i sekci `projects` z
# ~/.claude.json — všechny projekty, ve kterých už uživatel spustil Claude Code,
# se detekují bez konfigurace. V Dockeru ale fungují jen ty cesty, které máš
# mountnuté — proto se vyplatí nastavit jeden parent dir přes tuto proměnnou.
#
# Default v compose.yaml fallbackuje na ${USERPROFILE}/Claude — pokud projekty
# držíš jinde (např. D:\Claude), nastav tady:
CLAUDE_HUB_WORKSPACE_ROOT_D=D:\Claude

# Volitelně přepiš ID a název týmu (jinak default "main" / "Tým").
# CLAUDE_HUB_TEAM_ID=main
# CLAUDE_HUB_TEAM_NAME=Tým

# Volitelně přepiš veřejnou URL Hubu (pro instalační hint daemonu).
# CLAUDE_HUB_PUBLIC_URL=https://hub.animato-lab.cz

# ── Autentizace ─────────────────────────────────────────────────────────
# Allowlist e-mailů / domén, které se smí zaregistrovat. Položka může být
# buď konkrétní e-mail (`jmeno@example.com`), nebo doména (`animato.cz` →
# projde každý `*@animato.cz`). Více oddělené čárkou. Prázdné = registrace
# zakázaná. Pro veřejně dostupný hub POVINNÉ nastavit.
CLAUDE_HUB_ALLOWED_EMAILS=animato.cz

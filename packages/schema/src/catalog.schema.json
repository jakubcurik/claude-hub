{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-hub.local/schemas/catalog-asset.schema.json",
  "title": "Claude Hub Catalog Asset",
  "type": "object",
  "required": [
    "id",
    "type",
    "slug",
    "name",
    "summary",
    "description",
    "owner",
    "version",
    "risk",
    "tags",
    "compatibility",
    "permissions",
    "requiredEnv",
    "files"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["skill", "command", "mcp", "hook", "plugin", "config"]
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string" },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "restricted"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requiredEnv": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "executable": { "type": "boolean" }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://claude-hub.local/schemas/catalog-asset.schema.json",
  "title": "Claude Hub Catalog Asset",
  "type": "object",
  "required": [
    "id",
    "type",
    "slug",
    "name",
    "summary",
    "description",
    "owner",
    "version",
    "risk",
    "tags",
    "usedBy",
    "updatedAt",
    "compatibility",
    "permissions",
    "requiredEnv",
    "files"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "type": {
      "type": "string",
      "enum": ["skill", "command", "mcp", "hook", "plugin", "config"],
      "$comment": "Pro type=\"plugin\" se očekává recipe payload: pole `files` obsahuje jediný soubor s `path` = \"recipe.json\" a `content` = JSON-stringified PluginRecipe (viz packages/schema/src/index.ts). Daemon recipe naparsuje, naklonuje marketplace repo do ~/.claude/plugins/marketplaces/<name>/ a JSON-patchuje ~/.claude/settings.json (extraKnownMarketplaces, enabledPlugins, pluginConfigs). Validace probíhá v API a v daemonu, ne v JSON Schema (cross-field conditional)."
    },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "owner": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "avatarUrl": { "type": "string", "format": "uri" }
      }
    },
    "version": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "string",
      "enum": ["low", "medium", "high", "restricted"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "usedBy": { "type": "number", "minimum": 0 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "compatibility": {
      "type": "object",
      "required": ["platforms"],
      "properties": {
        "claudeCode": { "type": "string" },
        "daemon": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "enum": ["darwin", "linux", "windows"] }
        }
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["label", "description", "level"],
        "properties": {
          "label": { "type": "string" },
          "description": { "type": "string" },
          "level": {
            "type": "string",
            "enum": ["low", "medium", "high", "restricted"]
          }
        }
      }
    },
    "requiredEnv": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "content": { "type": "string" },
          "executable": { "type": "boolean" }
        }
      }
    },
    "contentHash": {
      "type": "string",
      "description": "Volitelný SHA-256 hash sloučených souborů balíčku pro integritní ověření."
    }
  }
}

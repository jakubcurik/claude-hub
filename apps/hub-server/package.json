{
  "name": "hub-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:gen": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.670.0",
    "@aws-sdk/s3-request-presigner": "^3.670.0",
    "@claude-hub/shared-types": "workspace:*",
    "@claude-hub/wss-protocol": "workspace:*",
    "@hono/node-server": "^1.13.2",
    "@hono/node-ws": "^1.3.1",
    "@node-rs/argon2": "^2.0.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.5",
    "minio": "^8.0.2",
    "pino": "^9.5.0",
    "postgres": "^3.4.5",
    "uuid": "^11.0.2",
    "ws": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/minio": "^10.28.0",
    "@testcontainers/postgresql": "^10.28.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.28.0",
    "testcontainers": "^10.28.0",
    "tsx": "^4.19.1",
    "vitest": "^2.1.3"
  }
}
